<?xml version="1.0" encoding="UTF-8"?>
<view viewid="managementserverpage">
<helptext></helptext>
	<header>
        <image>images/icons/managementserver.png</image>
		<name></name>
		<description></description>
	</header>
    <object title="Settings" viewtype="form" icon="settings-1" >
    <object name="Device.ManagementServer">
		<row>
			<col>
        		<parameter name="EnableCWMP"  type="checkbox" access="readonly" webname="CWMP Enable" ></parameter>
			</col>
		</row>
		<row>
			<col>
        		<parameter name="URL" type="string" access="readonly" placeholder="true" webname="ACS URL" required="false"></parameter>
			</col>
		</row>
		<row>
			<col>
        		<parameter name="Username" type="string" access="readonly" placeholder="true" webname="ACS Username" required="false"></parameter>
			</col>
			<col>
        		<parameter name="Password" type="password" access="readonly" webname="ACS Password" required="false"></parameter>
			</col>
		</row>
		<row>
			<col>
        		<parameter name="ConnectionRequestURL" required="false" type="string" access="readonly" webname="Connection Request URL" ></parameter>
			</col>
		</row>
		<row>
			<col>
        		<parameter name="ConnectionRequestUsername" type="string" access="readonly" placeholder="true" webname="Connection Request Username" required="false"></parameter>
			</col>
			<col>
        		<parameter name="ConnectionRequestPassword" type="password" access="readonly" webname="Connection Request Password" required="false"></parameter>
			</col>
		</row>

		<row>
			<col>
        		<parameter name="PeriodicInformEnable" type="toggle" access="readonly" webname="Periodic Inform Enable" required="false" ></parameter>
			</col>
		</row>
		<row>
			<col>
        		<parameter name="PeriodicInformInterval" type="number" access="readonly" placeholder="true" webname="Periodic Inform Interval" required="false"></parameter>
			</col>
			<col>
        		<parameter name="PeriodicInformTime" type="string" access="readonly" placeholder="true" webname="Periodic Inform Time" required="false"></parameter>
			</col>
		</row>
		<row>
			<col>
        		<parameter name="UpgradesManaged" required="false" type="checkbox" access="readonly" webname="Upgrades Managed"></parameter>
			</col>
		</row>
		<row>
			<col>
        		<parameter name="CWMPRetryMinimumWaitInterval" type="number"  access="readonly" placeholder="true" webname="CWMP Retry Minimum Wait Interval" required="false"></parameter>
			</col>
			<col>
        		<parameter name="CWMPRetryIntervalMultiplier" type="number" access="readonly" placeholder="true" webname="CWMP Retry Interval Multiplier" required="false"></parameter>
			</col>
		</row>
        <parameter  name="Modify"  action="post" routeurl="Apply($event)" type="submitbutton" webname="Modify" maxlen="64"></parameter>
        <!-- <parameter  name="Cancel"  routeurl="reset()" action="post" type="submitbutton" webname="Reset" maxlen="64"></parameter> -->
        <parameter  name="SendInform" routeurl="makePost('cgi_action','Action=SendInform',$event)"  type="submitbutton" webname="Send Inform" ></parameter>
    </object>

	<object name="Device.Firewall.Chain.2.Rule.1">
		<row>
			<col>
        		<parameter name="Target" type="checkbox" truevalue="Accept" falsevalue="Drop" webname="Enable Wan Access" required="false"></parameter>
			</col>
		</row>
	</object>
    </object>
</view>
